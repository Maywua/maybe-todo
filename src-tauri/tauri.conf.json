{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Maybe Todo",
  "version": "0.1.0",
  "identifier": "com.maybetodo.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Maybe Todo",
        "width": 1120,
        "height": 820,
        "minWidth": 560,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "decorations": false,
        "create": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
